@{
    ViewData["Title"] = "Index";
}
<div class="row">
    <div class="col-9">
        <h2 class="text-primary">Products Roll</h2>
    </div>
    <div class="col-3">
        <a asp-action="Upsert" class="btn btn-info form-control">
            <i class="fas fa-plus">&nbsp; Add New Products</i>
        </a>
    </div>
</div>
<div class="container rounded border p-2 m-2">
    <div class="table-responsive">
        <table id="tbldata" class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Description</th>
                    <th>Author</th>
                    <th>Isbn</th>
                    <th>Price</th>
                    <th>Actions</th>
                </tr>
            </thead>
        </table>
    </div>
</div>
@section scripts
{
    <script src="~/js/product.js"></script>
}