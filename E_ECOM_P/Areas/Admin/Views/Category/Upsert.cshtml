@model E_COM_Models.Category
@{
    var title = Model.id != 0 ? "Edit category" : "New category";
    var saveupdate = Model.id != 0 ? "Update" : "Save";

}
@* Now Design *@
<form method="post">
    @if (Model.id!=0) @* agar o nahi hai toh edit kar rahe hai *@
    {
        <input type="hidden"asp-for="id" />
    }
    <div class="col-10">
        <h2 class="text-primary">@title</h2>
        <div asp-validation-summary="ModelOnly"class="text-danger"></div>
        <div class="col-8">
            <div class="form-group row">
                <div class="col-4">
                    <label asp-for="Name"></label>
                </div>
                <div class="col-8">
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name"class="text-danger"></span>
                </div>

            </div> @* save Update*@
           @*  <div class="form-group row p-2 m-2">
                <div class="col-4 offset-4">
                <button type="submit"class="btn btn-info form-control">
                    @saveupdate
                </button>
                </div>
                <div class="col-4 offset-4">@* back to list button *@
                @*     <a asp-action="Index" class="btn btn-success form-control">
                        Back To List
                    </a>
                </div>
            </div *@@* > *@
            <div class="form-group row  p-2 m-2">
                <div class="col-8 offset-4">
            @if(Model.id!=0)    @* Edit *@
            {
                <partial name="_EditandBacktolist" />
            }
            else
            {
                <partial name="_CreateandBacktolist" />
            }
        </div>

    </div>
</form>
@* validations id is needed to Edit and Update *@
@section scripts
{
    <partial name="_ValidationScriptsPartial" />
        }