@model int
@{
    ViewData["Title"] = "OrderConfirm";
}

<h1>OrderConfirm</h1>


<div class="container row">
    <div class="col-12 text-center">
        <h2 class="text-primary text-center">Order Submitted Successfully</h2><br />
        <img src="~/images/successful-business-man-holding-trophy_1150-35042.jpg" width="50%" />
    </div>
    <div class="col-12 text-center" style="color:green">
        <br />
        Thank you for your order! <br />
        We have received your order and we will send a follow up email shortly!
        <br />
        Your Order Number is :@Model
    </div>
</div>



