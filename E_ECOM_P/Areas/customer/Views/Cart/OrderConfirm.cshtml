@model int

<div class="order-confirm-wrapper">
    <div class="order-confirm-card">
        <div class="success-icon">
            <i class="fas fa-check"></i>
        </div>

        <h1 class="order-confirm-title">Thank you for your order</h1>

        <p class="order-confirm-text">
            Your order is placed and paid.<br />
            Check your email for confirmation.
        </p>

        <p class="order-confirm-number">
            Order Number: <span>#@Model</span>
        </p>

        <div class="order-confirm-actions">
            
            <a asp-area="" asp-controller="Home" asp-action="Index" class="btn-pustak-outline">
                Continue Shopping
            </a>
        </div>
    </div>
</div>

<style>
    .order-confirm-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 70vh;
        padding: 24px;
    }

    .order-confirm-card {
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 10px 40px rgba(15, 23, 42, 0.08);
        padding: 56px 40px;
        max-width: 480px;
        width: 100%;
        text-align: center;
    }

    .success-icon {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 28px;
    }

        .success-icon i {
            color: #38bdf8;
            font-size: 28px;
        }

    .order-confirm-title {
        font-family: 'Playfair Display', serif;
        font-weight: 700;
        color: #0f172a;
        font-size: 2rem;
        margin-bottom: 16px;
    }

    .order-confirm-text {
        font-family: 'Inter', sans-serif;
        color: #64748b;
        font-size: 1rem;
        line-height: 1.6;
        margin-bottom: 20px;
    }

    .order-confirm-number {
        font-family: 'Inter', sans-serif;
        font-size: 0.95rem;
        color: #334155;
        margin-bottom: 36px;
    }

        .order-confirm-number span {
            color: #0f172a;
            font-weight: 700;
        }

    .order-confirm-actions {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .btn-pustak-primary {
        background: #0f172a;
        color: #f8fafc;
        border-radius: 50px;
        padding: 14px 24px;
        font-weight: 600;
        font-family: 'Inter', sans-serif;
        text-decoration: none;
        transition: background 0.2s ease;
    }

        .btn-pustak-primary:hover {
            background: #1e3a8a;
            color: #ffffff;
        }

    .btn-pustak-outline {
        background: transparent;
        color: #0f172a;
        border: 1.5px solid #cbd5e1;
        border-radius: 50px;
        padding: 14px 24px;
        font-weight: 600;
        font-family: 'Inter', sans-serif;
        text-decoration: none;
        transition: all 0.2s ease;
    }

        .btn-pustak-outline:hover {
            border-color: #0f172a;
            background: #f7f8fa;
        }
</style>