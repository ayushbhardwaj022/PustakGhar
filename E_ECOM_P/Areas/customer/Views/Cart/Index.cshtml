@model E_COM_Models.ViewModels.ShoppingCartVM
<form method="post" asp-action="Index" asp-controller="Cart">
    @Html.AntiForgeryToken()
    <br />
    <div class="backgroundWhiteBorder">
        <div class="container">
            <div class="card">
                <div class="card-header bg-dark text-light ml-0 row container">
                    <div class="col-6">
                        <i class="fa fa-shopping-cart"></i> &nbsp;
                        Shopping Cart
                    </div>
                    <div class="col-6 text-right">
                        <a asp-action="Index" asp-controller="Home" class="btn btn-outline-info">
                            Continue shopping
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">
                            @TempData["Error"]
                        </div>
                    }
                    @foreach (var list in Model.Listcart)
                    {
                        var amount = list.price * list.count;


                        <div class="row">
                            <div class="d-none d-lg-block col-lg-1 text-center py-2">
                                <input type="checkbox" name="selectedproducts" value="@list.id" />

                                <img src="@list.Product.Imageurl" class="rounded" width="100%" />
                            </div>
                            <div class="col-12 text-sm-center col-lg-6 text-lg-left">
                                <h5><strong>@list.Product.Title</strong></h5>
                                <p><small>@Html.Raw(list.Product.Description)</small></p>
                            </div>
                            <div class="col-12 text-sm-center col-lg-5 text-lg-right row">
                                <div class="col-4 text-md-right" style="padding-top:5px;">
                                    <h6><strong>@list.Product.price <span class="text-muted">x</span> @list.count=@amount </strong></h6>
                                </div>
                                <div class="col-6 col-sm-4 col-lg-6">
                                    <div class="float-right mx-1">
                                        <a asp-action="plus" asp-route-id="@list.id" class="btn btn-primary">
                                            <i class="fas fa-plus"></i>
                                        </a>

                                    </div>
                                    <div class="float-right mx-1">
                                        <a asp-action="minus" asp-route-id="@list.id" class="btn btn-danger">
                                            <i class="fas fa-minus"></i>
                                        </a>

                                    </div>
                                </div>
                                <div class="col-2 col-sm-4 col-lg-2 text-right">
                                    <a asp-action="delete" asp-route-id="@list.id" class="btn btn-outline-danger">
                                        <i class="fas fa-trash"></i>
                                    </a>

                                </div>
                            </div>
                        </div>
                    }
                    <hr />
                    <div class="row">
                        <div class="col-12 col-md-6 offset-md-6 col-lg-4 offset-lg-8 pr-4">
                            <ul class="list-group">
                                <li class="list-group-item d-flex justify-content-between bg-light">
                                    <span class="text-info"> Total (INR)</span>
                                    <strong class="text-info">₹ <span id="txtOrderTotal">@Model.OrderHeader.OrderTotal</span></strong>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <div class="row justify-content-end">
                        <div class="col-sm-12 col-md-6 col-lg-4">
                            <button type="submit" class="btn btn-success w-100">Summary</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

